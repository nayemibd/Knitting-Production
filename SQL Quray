WITH subcon_data AS (
    SELECT
        a.product_date,
        CASE WHEN a.knitting_company IN (1,2,4) THEN a.knitting_company ELSE 0 END AS company_group,
        SUM(b.product_qnty) AS subcon_production_qty,
        SUM(b.reject_qnty) AS subcon_reject_qty,
        COUNT(DISTINCT b.machine_id) AS subcon_machine_count
    FROM subcon_production_mst a
    JOIN subcon_production_dtls b ON a.id = b.mst_id
    WHERE a.product_type = 2
      AND a.status_active = 1
      AND a.knitting_source = 1
      AND b.status_active = 1
      AND b.product_type = 2
      AND b.machine_id <> 0
    GROUP BY
        a.product_date,
        CASE WHEN a.knitting_company IN (1,2,4) THEN a.knitting_company ELSE 0 END
)
SELECT
    a.receive_date AS prod_date,
    
    CASE
        WHEN a.knitting_company = 1 THEN 'METRO'
        WHEN a.knitting_company = 2 THEN 'BEACON'
        WHEN a.knitting_company = 4 THEN 'SCANDEX'
        ELSE 'OutSide'
    END AS prod_company,

    COUNT(DISTINCT b.floor_id) AS floor_count,

    SUM(CASE WHEN c.is_sales = 0 AND c.booking_without_order = 0
             THEN NVL(c.qc_pass_qnty,0) ELSE 0 END) AS bulk_production,

    SUM(CASE WHEN c.is_sales = 0 AND c.booking_without_order = 1
             THEN NVL(c.qc_pass_qnty,0) ELSE 0 END) AS sample_production,

    SUM(CASE WHEN c.is_sales = 0
             THEN NVL(c.qc_pass_qnty,0) ELSE 0 END) AS prod_qnty_without_sales,

    SUM(CASE WHEN c.is_sales = 1
             THEN NVL(c.qc_pass_qnty,0) ELSE 0 END) AS sales_prod_qty,

    NVL(sd.subcon_production_qty,0) AS subcon_prod_qty,

    SUM(NVL(c.reject_qnty,0)) AS reject_qnty,
    NVL(sd.subcon_reject_qty,0) AS subcon_reject_qty,

    COUNT(DISTINCT CASE
        WHEN c.is_sales = 0 AND NVL(c.qc_pass_qnty,0) > 0
        THEN b.machine_no_id END) AS machine_count_without_sales,

    COUNT(DISTINCT CASE
        WHEN c.is_sales = 1 AND NVL(c.qc_pass_qnty,0) > 0
        THEN b.machine_no_id END) AS machine_count_sales,

    NVL(sd.subcon_machine_count,0) AS subcon_machine_count,

    -- Total Production
    NVL(SUM(CASE WHEN c.is_sales = 0 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
  + NVL(SUM(CASE WHEN c.is_sales = 1 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
  + NVL(sd.subcon_production_qty,0) AS total_production,

    -- Total Rejection
    SUM(NVL(c.reject_qnty,0)) + NVL(sd.subcon_reject_qty,0) AS total_rejection,

    -- Total Machines
    COUNT(DISTINCT CASE
        WHEN c.is_sales = 0 AND NVL(c.qc_pass_qnty,0) > 0
        THEN b.machine_no_id END)
    + COUNT(DISTINCT CASE
        WHEN c.is_sales = 1 AND NVL(c.qc_pass_qnty,0) > 0
        THEN b.machine_no_id END)
    + NVL(sd.subcon_machine_count,0) AS total_machine,

    -- Reject Percent
    CASE 
        WHEN NVL(
                NVL(SUM(CASE WHEN c.is_sales = 0 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
              + NVL(SUM(CASE WHEN c.is_sales = 1 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
              + NVL(sd.subcon_production_qty,0), 0) = 0 
        THEN 0
        ELSE 
            (SUM(NVL(c.reject_qnty,0)) + NVL(sd.subcon_reject_qty,0)) / 
            (NVL(SUM(CASE WHEN c.is_sales = 0 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
           + NVL(SUM(CASE WHEN c.is_sales = 1 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
           + NVL(sd.subcon_production_qty,0)) * 100
    END AS reject_percent,

    -- Avg Production per Machine
    CASE 
        WHEN (COUNT(DISTINCT CASE WHEN c.is_sales = 0 AND NVL(c.qc_pass_qnty,0) > 0 THEN b.machine_no_id END)
              + COUNT(DISTINCT CASE WHEN c.is_sales = 1 AND NVL(c.qc_pass_qnty,0) > 0 THEN b.machine_no_id END)
              + NVL(sd.subcon_machine_count,0)) = 0 
        THEN 0
        ELSE
            (NVL(SUM(CASE WHEN c.is_sales = 0 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
           + NVL(SUM(CASE WHEN c.is_sales = 1 THEN NVL(c.qc_pass_qnty,0) ELSE 0 END),0)
           + NVL(sd.subcon_production_qty,0))
            / (COUNT(DISTINCT CASE WHEN c.is_sales = 0 AND NVL(c.qc_pass_qnty,0) > 0 THEN b.machine_no_id END)
             + COUNT(DISTINCT CASE WHEN c.is_sales = 1 AND NVL(c.qc_pass_qnty,0) > 0 THEN b.machine_no_id END)
             + NVL(sd.subcon_machine_count,0))
    END AS avg_production_per_machine

FROM inv_receive_master a
JOIN pro_grey_prod_entry_dtls b ON a.id = b.mst_id
LEFT JOIN pro_roll_details c
       ON b.id = c.dtls_id
      AND c.status_active = 1
      AND c.is_deleted = 0
LEFT JOIN subcon_data sd
       ON sd.product_date = a.receive_date
      AND sd.company_group = a.knitting_company

WHERE a.entry_form = 2
  AND a.item_category = 13
  AND a.status_active = 1
  AND b.status_active = 1
  AND b.machine_no_id <> 0


GROUP BY
    a.receive_date,
    CASE
        WHEN a.knitting_company = 1 THEN 'METRO'
        WHEN a.knitting_company = 2 THEN 'BEACON'
        WHEN a.knitting_company = 4 THEN 'SCANDEX'
        ELSE 'OutSide'
    END,
    sd.subcon_production_qty,
    sd.subcon_reject_qty,
    sd.subcon_machine_count

ORDER BY
    a.receive_date;
